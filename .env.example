# Copy this file to .env and edit. Never commit .env.

# development | production | testing
APP_ENV=development

# REQUIRED in production (min. 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite by default (stored in ./instance/surveys.db). For PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/surveys   (also: pip install "psycopg[binary]")
DATABASE_URL=sqlite:///surveys.db

# Shown in the navbar, page titles and footer
SITE_NAME=Судалгааны систем

# Times are stored in UTC and displayed/exported in this timezone
APP_TIMEZONE=Asia/Ulaanbaatar

# --- Sessions & cookies -------------------------------------------------
# Admin session length in minutes
SESSION_LIFETIME_MINUTES=120
# Leave true in production (HTTPS). Set false ONLY to test the production
# config over plain http://localhost - browsers drop Secure cookies on http.
SESSION_COOKIE_SECURE=true

# --- Google sign-in (optional) ------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR-DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts that are auto-created as admins on first sign-in
ADMIN_EMAILS=

# --- Reverse proxy ------------------------------------------------------
# Number of proxies in front of the app (nginx = 1). Needed so client IPs,
# https URLs and Google's redirect URI are detected correctly. 0 = none.
TRUSTED_PROXY_COUNT=0

# --- Rate limiting ------------------------------------------------------
# Use a shared store (e.g. redis://redis:6379/0) when running more than one worker/container.
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=10 per minute
# Per IP address. A school computer lab shares one IP, so keep this generous.
SURVEY_RATE_LIMIT=100 per hour

LOG_LEVEL=INFO
